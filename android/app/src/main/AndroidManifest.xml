<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase AI Logic (the plan from finding codes, when plan help is on), App Check and Remote Config. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- To see every app on the phone, so the check can list those that can watch it. Read only: Spare Key never
         opens, changes or removes another app. The app is installed from the project's site, not Google Play. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".SpareKeyApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@null"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpareKey"
        tools:targetApi="36">
        <!-- No usage statistics: Firebase's libraries (the AI and ML ones log how they are used) keep theirs off.
             Spare Key has no analytics and no crash reporting of its own. Checked in tools/android-e2e.mjs. -->
        <meta-data android:name="firebase_data_collection_default_enabled" android:value="false" />
        <meta-data android:name="firebase_ml_collection_enabled" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
